<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/Splash"
    android:id="@+id/nav_graph">

    <fragment
        android:id="@+id/Splash"
        android:name="com.gc.waravi.views.fragments.SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/register_id"
            app:destination="@id/Register"
            app:popUpToInclusive="true"
            app:popUpTo="@id/Splash"/>

        <action
            android:id="@+id/goDial"
            app:destination="@id/Main"
            app:popUpToInclusive="true"
            app:popUpTo="@id/Splash"/>
    </fragment>

    <fragment
        android:id="@+id/Group"
        android:name="com.gc.waravi.views.fragments.DefaultRoomMeetingFragment"
        tools:layout="@layout/fragment_default_meeting">
        <action
            android:id="@+id/leave_group"
            app:destination="@id/PopUp"
            app:popUpTo="@id/Main"
            app:popUpToInclusive="false"/>
    </fragment>

    <fragment
        android:id="@+id/Register"
        android:name="com.gc.waravi.views.fragments.RegisterFragment"
        tools:layout="@layout/fragment_register">

        <action
            android:id="@+id/goDial"
            app:destination="@id/Main"
            app:popUpToInclusive="true"
            app:popUpTo="@id/nav_graph"/>
        <action
            android:id="@+id/show_input_error"
            app:destination="@id/PopUp" />
    </fragment>
    <fragment
        android:id="@+id/Main"
        android:name="com.gc.waravi.views.fragments.MainFragment"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/register_new_id"
            app:popUpTo="@id/Main"
            app:popUpToInclusive="false"
            app:destination="@id/Register" />
        <action
            android:id="@+id/joinGroup"
            app:destination="@id/Group"
            app:popUpTo="@id/Main"
            app:popUpToInclusive="false"/>

        <action
            android:id="@+id/showSetting"
            app:destination="@id/Setting"
            app:popUpTo="@id/Main"
            app:popUpToInclusive="false"/>

    </fragment>

    <fragment
        android:id="@+id/IncomingCall"
        android:name="com.gc.waravi.views.fragments.IncomingCallFragment"
        android:label="fragment_incoming_call"
        tools:layout="@layout/fragment_incoming_call" >
        <action
            android:id="@+id/decline_call"
            app:destination="@id/Main" />

        <action
            android:id="@+id/missed_call"
            app:destination="@id/PopUp"/>
    </fragment>
    <fragment
        android:id="@+id/PopUp"
        android:name="com.gc.waravi.views.fragments.PopupFragment"
        android:label="frangment_popup"
        tools:layout="@layout/fragment_popup" >
        <argument
            android:name="message"
            app:argType="string"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/Setting"
        android:name="com.gc.waravi.views.fragments.SettingFragment"
        android:label="fragment_web"
        tools:layout="@layout/fragment_setting"/>
</navigation>