<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:textAllCaps">false</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="text_color_light">@color/black</item>
        <item name="text_color_dark">@color/white</item>
        <item name="android:fontFamily">@font/sf_pro</item>
        <item name="radioButtonStyle">@style/normal_radio</item>
        <item name="switchStyle">@style/normal_switch</item>
        <item name="editTextStyle">@style/App_EditTextStyle</item>
        <item name="tab_background_color">@color/bg_tab_light</item>
        <item name="tab_icon_color">@color/tab_icon_tint</item>
        <item name="secondary_button_background_color">@color/white</item>
        <item name="box_background_color">@color/white</item>
        <item name="textbox_background_color">@color/white</item>
        <item name="box_short_background_color">@color/bg_short_light</item>
        <item name="alertDialogTheme">@style/Theme.AppCompat.Light.Dialog.Alert</item>
    </style>

    <style name="AppTheme.Dark" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:textAllCaps">false</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="text_color_light">@color/white</item>
        <item name="text_color_dark">@color/black</item>
        <item name="android:fontFamily">@font/sf_pro</item>
        <item name="radioButtonStyle">@style/normal_radio</item>
        <item name="switchStyle">@style/normal_switch</item>
        <item name="editTextStyle">@style/App_EditTextStyle</item>
        <item name="tab_background_color">@color/bg_tab_dark</item>
        <item name="tab_icon_color">@color/white</item>
        <item name="secondary_button_background_color">@color/gray</item>
        <item name="box_background_color">@color/bg_dialog_gray</item>
        <item name="textbox_background_color">@color/bg_textbox_dark</item>
        <item name="box_short_background_color">@color/bg_short_dark</item>
        <item name="alertDialogTheme">@style/Theme.AppCompat.DayNight.Dialog.Alert</item>
    </style>

    <style name="NormalTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
    </style>

    <style name="App_EditTextStyle" parent="Base.Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_normal_edittext</item>
        <item name="android:paddingTop">@dimen/padding_small</item>
        <item name="android:paddingBottom">@dimen/padding_small</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
    </style>

    <style name="DialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowMinWidthMinor">80%</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">8dp</item>
    </style>

    <style name="DialogBottomTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <style name="DialogUpTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowEnterAnimation">@anim/slide_down</item>
        <item name="android:windowExitAnimation">@anim/slide_up</item>
    </style>

    <style name="base_text">
        <item name="fontFamily">@font/sf_pro</item>
    </style>
    <style name="numpad_button" parent="base_text">
        <item name="minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/text_color_light</item>
        <item name="android:background">@drawable/button_numpad</item>
        <item name="android:textSize">@dimen/numpad_key_text</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="normal_button" parent="base_text">
        <item name="android:minHeight">50dp</item>
        <item name="android:minWidth">140dp</item>
        <item name="android:paddingStart">@dimen/padding_normal</item>
        <item name="android:paddingEnd">@dimen/padding_normal</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_normal_button</item>
        <item name="android:textSize">@dimen/font_size_small</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="secondary_button">
        <item name="android:minHeight">50dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_normal_button_white</item>
        <item name="android:textColor">?attr/text_color_light</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="text_menu_item" parent="base_text">
        <item name="android:height">42dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_menu_item</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:drawablePadding">10dp</item>
    </style>

    <style name="InputCodeTextBox" parent="base_text">
        <item name="android:background">@drawable/bg_code_input</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">?attr/text_color_light</item>
        <item name="android:textSize">@dimen/numpad_key_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="normal_switch" parent="Base.Widget.AppCompat.CompoundButton.Switch">
        <item name="android:drawableStart">@drawable/bg_switch_thumb</item>
        <item name="android:thumb">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:padding">@dimen/padding_small</item>
        <item name="android:background">@drawable/bg_box_normal_trans</item>
        <item name="android:textColor">@color/switch_text_color</item>
    </style>

    <style name="normal_radio" parent="Base.Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:drawableStart">@drawable/bg_radio_thumb</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:padding">@dimen/padding_small</item>
        <item name="android:background">@drawable/bg_box_normal_trans</item>
        <item name="android:textColor">?attr/text_color_light</item>
    </style>

    <style name="vertical_radio" parent="normal_radio">
        <item name="android:drawableStart">@null</item>
        <item name="android:drawableBottom">@drawable/bg_radio_thumb</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">@dimen/padding_normal</item>
        <item name="android:paddingEnd">@dimen/padding_normal</item>
    </style>

</resources>
