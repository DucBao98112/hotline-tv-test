<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:background="@color/black"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <view
        class="com.ntt.skyway.core.content.sink.SurfaceViewRenderer"
        android:id="@+id/view_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/participant_track_switch_off_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_account_circle_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/view_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/view_frame"
        app:layout_constraintEnd_toEndOf="@id/view_frame"
        app:layout_constraintTop_toTopOf="@id/view_frame"
        app:layout_constraintBottom_toBottomOf="@id/view_frame"
        android:visibility="gone"
        android:padding="0dp"
        android:scaleType="centerCrop"
        android:src="@color/black"
        android:alpha="0.7"/>

    <View
        android:id="@+id/view_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:duplicateParentState="true"
        android:background="@drawable/bg_border_rectange"/>

    <TextView
        android:id="@+id/tv_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:gravity="start"
        android:background="#25000000"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="@dimen/font_size_small"
        android:singleLine="true" />

</androidx.constraintlayout.widget.ConstraintLayout>