<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_message"
    android:layout_width="@dimen/chat_layout_width"
    android:layout_height="match_parent"
    android:elevation="2dp"
    android:translationX="@dimen/chat_layout_width">

    <View
        android:id="@+id/view_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/chat_panel_bg" />

    <View
        android:id="@+id/view_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1F2937"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:elevation="1dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="@id/view_header"
        app:layout_constraintStart_toStartOf="@id/view_header"
        app:layout_constraintTop_toTopOf="@id/view_header"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/imv_logo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_logo_circle"
        app:layout_constraintBottom_toBottomOf="@id/view_header"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/view_header" />

    <ImageView
        android:id="@+id/imv_logo_title"
        android:layout_width="60dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_logo_title"
        app:layout_constraintBottom_toBottomOf="@id/view_header"
        app:layout_constraintStart_toEndOf="@id/imv_logo"
        app:layout_constraintTop_toTopOf="@id/view_header"
        app:tint="@color/white" />

    <View
        android:id="@+id/view_chat_actions"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/chat_panel_bg"
        app:layout_constraintBottom_toBottomOf="parent" />

    <EditText
        android:id="@+id/edt_message"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_chat_input"
        android:hint="Type a message..."
        android:textColorHint="#9CA3AF"
        android:textColor="@color/white"
        android:imeOptions="actionSend"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@id/view_chat_actions"
        app:layout_constraintEnd_toStartOf="@id/btn_send"
        app:layout_constraintStart_toStartOf="@id/view_chat_actions"
        app:layout_constraintTop_toTopOf="@id/view_chat_actions" />

    <ImageButton
        android:id="@+id/btn_send"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/circle_button_gray_background"
        android:backgroundTint="@color/chat_bubble_me"
        android:elevation="2dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_send"
        app:layout_constraintBottom_toBottomOf="@id/view_chat_actions"
        app:layout_constraintEnd_toEndOf="@id/view_chat_actions"
        app:layout_constraintTop_toTopOf="@id/view_chat_actions"
        app:tint="@color/white" />

    <androidx.leanback.widget.BrowseFrameLayout
        android:id="@+id/chat_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/view_chat_actions"
        app:layout_constraintTop_toBottomOf="@id/view_header">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="5dp" />
    </androidx.leanback.widget.BrowseFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>