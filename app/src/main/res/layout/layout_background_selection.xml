<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_box_normal"
    android:backgroundTint="@color/chat_panel_bg"
    android:descendantFocusability="afterDescendants"
    android:padding="12dp">

    <!-- TITLE -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_virtual_bg"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- BLUR SWITCH -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_blur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_blur_off"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:minHeight="40dp"
        app:switchPadding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <!-- DIVIDER -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="#33FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/sw_blur" />

    <!-- BACKGROUND LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_backgrounds"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:overScrollMode="never"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintTop_toBottomOf="@id/divider"
        tools:listitem="@layout/item_background_preset" />

    <!-- CLOSE -->
    <Button
        android:id="@+id/btn_close"
        android:layout_width="96dp"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:text="@string/btn_close"
        android:textSize="14sp"
        android:background="@drawable/bg_button_main"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_backgrounds"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
