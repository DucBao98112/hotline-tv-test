<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:paddingTop="@dimen/padding_normal"
    android:paddingBottom="@dimen/padding_small"
    tools:context=".views.fragments.RegisterFragment">

    <TextView
        android:id="@+id/tv_1"
        style="@style/base_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/lbl_auth_code_input"
        android:textColor="?attr/text_color_light"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_2"
        style="@style/base_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/lbl_sub_auth_code_input"
        android:textColor="?attr/text_color_light"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tv_1"
        app:layout_constraintStart_toStartOf="@id/tv_1"
        app:layout_constraintTop_toBottomOf="@id/tv_1" />

    <TextView
        android:id="@+id/textBox1"
        style="@style/InputCodeTextBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="@dimen/padding_small"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/textBox2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_2"
        app:layout_constraintWidth_percent="0.07"
        tools:text="1" />

    <TextView
        android:id="@+id/textBox2"
        style="@style/InputCodeTextBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/textBox3"
        app:layout_constraintStart_toEndOf="@id/textBox1"
        app:layout_constraintTop_toTopOf="@id/textBox1"
        app:layout_constraintWidth_percent="0.07" />

    <TextView
        android:id="@+id/textBox3"
        style="@style/InputCodeTextBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/textBox4"
        app:layout_constraintStart_toEndOf="@id/textBox2"
        app:layout_constraintTop_toTopOf="@id/textBox1"
        app:layout_constraintWidth_percent="0.07" />

    <TextView
        android:id="@+id/textBox4"
        style="@style/InputCodeTextBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/textBox5"
        app:layout_constraintStart_toEndOf="@id/textBox3"
        app:layout_constraintTop_toTopOf="@id/textBox1"
        app:layout_constraintWidth_percent="0.07" />

    <TextView
        android:id="@+id/textBox5"
        style="@style/InputCodeTextBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/textBox6"
        app:layout_constraintStart_toEndOf="@id/textBox4"
        app:layout_constraintTop_toTopOf="@id/textBox1"
        app:layout_constraintWidth_percent="0.07" />

    <TextView
        android:id="@+id/textBox6"
        style="@style/InputCodeTextBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/textBox7"
        app:layout_constraintStart_toEndOf="@id/textBox5"
        app:layout_constraintTop_toTopOf="@id/textBox1"
        app:layout_constraintWidth_percent="0.07" />

    <TextView
        android:id="@+id/textBox7"
        style="@style/InputCodeTextBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/textBox8"
        app:layout_constraintStart_toEndOf="@id/textBox6"
        app:layout_constraintTop_toTopOf="@id/textBox1"
        app:layout_constraintWidth_percent="0.07" />

    <TextView
        android:id="@+id/textBox8"
        style="@style/InputCodeTextBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/textBox9"
        app:layout_constraintStart_toEndOf="@id/textBox7"
        app:layout_constraintTop_toTopOf="@id/textBox1"
        app:layout_constraintWidth_percent="0.07" />

    <TextView
        android:id="@+id/textBox9"
        style="@style/InputCodeTextBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/textBox10"
        app:layout_constraintStart_toEndOf="@id/textBox8"
        app:layout_constraintTop_toTopOf="@id/textBox1"
        app:layout_constraintWidth_percent="0.07" />

    <TextView
        android:id="@+id/textBox10"
        style="@style/InputCodeTextBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="50dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textBox9"
        app:layout_constraintTop_toTopOf="@id/textBox1"
        app:layout_constraintWidth_percent="0.07" />

    <include
        android:id="@+id/layoutDial"
        layout="@layout/layout_dial"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/padding_small"
        android:layout_marginBottom="@dimen/padding_small"
        app:layout_constraintBottom_toTopOf="@id/btn_ok"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textBox1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_ok"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_button_main"
        android:scaleType="fitCenter"
        android:textColor="@color/white"
        app:layout_constraintDimensionRatio="814:322"
        app:layout_constraintWidth_percent="0.2"
        android:text="@string/txt_check"
        android:textSize="@dimen/font_size_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/layoutDial"
        app:layout_constraintStart_toStartOf="@id/layoutDial" />

    <ProgressBar
        android:id="@+id/pb_loading"
        android:visibility="gone"
        android:layout_width="35dp"
        android:layout_height="35dp"
        app:layout_constraintTop_toBottomOf="@id/layoutDial"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/layoutDial"
        app:layout_constraintEnd_toEndOf="@id/layoutDial"/>

</androidx.constraintlayout.widget.ConstraintLayout>