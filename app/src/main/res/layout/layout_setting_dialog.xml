<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@android:color/transparent"
    android:paddingHorizontal="@dimen/padding_small"
    android:paddingVertical="@dimen/padding_normal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:textSize="@dimen/font_size_large"
            android:text="@string/lbl_setting"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="@dimen/padding_small"
            android:layout_marginStart="@dimen/padding_small"/>

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/circle_button_background"
            android:backgroundTint="@color/button_text_color"
            app:tint="@android:color/black"
            android:layout_marginTop="@dimen/padding_small"
            android:layout_marginEnd="@dimen/padding_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_sound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:paddingHorizontal="@dimen/padding_small"
            android:text="@string/lbl_sound_setting"
            android:textColor="#5C5C5C"
            android:textSize="@dimen/font_size_small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <RadioGroup
            android:id="@+id/rdg_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_normal"
            app:layout_constraintTop_toBottomOf="@id/tv_sound"
            android:orientation="horizontal">
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rd_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_no_sound"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_normal"
                android:background="@drawable/list_item_background"
                android:button="@null"
                android:drawableTop="?android:attr/listChoiceIndicatorSingle"
                />
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rd_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/padding_normal"
                android:background="@drawable/list_item_background"
                android:button="@null"
                android:drawableTop="?android:attr/listChoiceIndicatorSingle"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rd_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/padding_normal"
                android:background="@drawable/list_item_background"
                android:button="@null"
                android:drawableTop="?android:attr/listChoiceIndicatorSingle"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rd_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/padding_normal"
                android:background="@drawable/list_item_background"
                android:button="@null"
                android:drawableTop="?android:attr/listChoiceIndicatorSingle"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rd_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/padding_normal"
                android:background="@drawable/list_item_background"
                android:button="@null"
                android:drawableTop="?android:attr/listChoiceIndicatorSingle"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rd_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_volume_max"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_normal"
                android:background="@drawable/list_item_background"
                android:button="@null"
                android:drawableTop="?android:attr/listChoiceIndicatorSingle"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </RadioGroup>

        <View
            android:id="@+id/divider0"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            app:layout_constraintTop_toBottomOf="@id/rdg_sound"
            android:layout_marginTop="5dp"/>

        <TextView
            android:id="@+id/tv_voice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_volume_setting"
            android:layout_marginTop="15dp"
            android:paddingHorizontal="@dimen/padding_small"
            android:textColor="#5C5C5C"
            android:textSize="@dimen/font_size_small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider0" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/sb_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/tv_voice_title"
            app:tint="@color/colorAccent"/>

        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            app:layout_constraintTop_toBottomOf="@id/sb_volume"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/lbl_auto_accept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:paddingHorizontal="@dimen/padding_small"
            android:text="@string/lbl_auto_accept_setting"
            android:textColor="#5C5C5C"
            android:textSize="@dimen/font_size_small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider1" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rd_auto_accept_enable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_on"
            android:gravity="center"
            android:layout_marginStart="@dimen/padding_normal"
            android:layout_marginTop="@dimen/padding_normal"
            android:paddingHorizontal="@dimen/padding_normal"
            android:background="@drawable/list_item_background"
            android:button="@null"
            android:nextFocusRight="@id/rd_auto_accept_disable"
            app:layout_constraintTop_toBottomOf="@id/lbl_auto_accept"
            app:layout_constraintStart_toStartOf="@id/lbl_auto_accept"
            android:drawableTop="?android:attr/listChoiceIndicatorSingle" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rd_auto_accept_disable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_off"
            android:gravity="center"
            android:layout_marginStart="@dimen/padding_large"
            android:paddingHorizontal="@dimen/padding_normal"
            android:background="@drawable/list_item_background"
            android:nextFocusLeft="@id/rd_auto_accept_enable"
            android:button="@null"
            app:layout_constraintTop_toTopOf="@id/rd_auto_accept_enable"
            app:layout_constraintStart_toEndOf="@id/rd_auto_accept_enable"
            android:drawableTop="?android:attr/listChoiceIndicatorSingle"
            />

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            app:layout_constraintTop_toBottomOf="@id/rd_auto_accept_enable"
            android:layout_marginTop="5dp"/>

        <Button
            android:id="@+id/btn_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_install_updates"
            android:layout_marginHorizontal="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/divider2"
            android:layout_marginTop="5dp"
            android:paddingHorizontal="@dimen/padding_small"
            android:background="@drawable/view_menu_rounded_background"
            android:gravity="start|center_vertical"/>

        <Button
            android:id="@+id/btn_restart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_restart"
            android:layout_marginHorizontal="@dimen/padding_small"
            app:layout_constraintTop_toBottomOf="@id/btn_update"
            android:paddingHorizontal="@dimen/padding_small"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/padding_small"
            android:background="@drawable/view_menu_rounded_background"
            android:gravity="start|center_vertical"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>