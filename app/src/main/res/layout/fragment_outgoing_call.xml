<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="40dp"
    tools:context=".views.fragments.IncomingCallFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <RelativeLayout
        android:id="@+id/layout_logo"
        app:layout_constraintBottom_toBottomOf="@id/gl_center"
        app:layout_constraintTop_toTopOf="@id/gl_center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imv_logo"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_centerHorizontal="true"
            android:src="@drawable/ic_logo_transparent" />

        <TextView
            android:id="@+id/txt_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/imv_logo"
            android:layout_marginTop="@dimen/padding_small"
            android:text="@string/lbl_calling"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/font_size_normal" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layout_logo"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_gravity="center"
            android:id="@+id/lbl_caller_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/font_number_large" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btn_cancel"
        android:layout_width="@dimen/default_button_size"
        android:layout_height="@dimen/default_button_size"
        android:background="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/button_decline_call"
        android:backgroundTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/barrier1"
        app:layout_constraintTop_toBottomOf="@id/layout_logo" />

    <TextView
        android:id="@+id/txt_mic_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_cancel"
        android:textColor="@color/white"
        android:text="Mic On"/>

    <TextView
        android:id="@+id/txt_camera_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_cancel"
        android:textColor="@color/white"
        android:text="Camera On"/>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="btn_toggle_mic, btn_toggle_camera"
        app:barrierDirection="top"/>

    <ImageButton
        android:id="@+id/btn_toggle_mic"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        app:tint="@color/button_text_color"
        android:background="@drawable/circle_button_background"
        android:padding="@dimen/padding_small"
        android:scaleType="fitCenter"
        android:src="@drawable/button_mic_level"
        app:layout_constraintStart_toStartOf="@id/txt_mic_status"
        app:layout_constraintEnd_toEndOf="@id/txt_mic_status"
        app:layout_constraintBottom_toTopOf="@id/txt_mic_status"/>

    <ImageButton
        android:id="@+id/btn_toggle_camera"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:padding="@dimen/padding_small"
        app:tint="@color/button_text_color"
        android:background="@drawable/circle_button_background"
        android:scaleType="fitCenter"
        android:src="@drawable/button_camera_level"
        app:layout_constraintStart_toStartOf="@id/txt_camera_status"
        app:layout_constraintEnd_toEndOf="@id/txt_camera_status"
        app:layout_constraintBottom_toTopOf="@id/txt_camera_status"/>

</androidx.constraintlayout.widget.ConstraintLayout>