<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/bg_call"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvGroupVideo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutVideo"
        android:focusable="true"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintDimensionRatio="16:9"
        android:layout_width="0dp"
        android:layout_height="0dp">

        <FrameLayout
            android:id="@+id/my_video"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/black"
            app:layout_constraintStart_toEndOf="@id/iv_arrow_left"
            app:layout_constraintEnd_toStartOf="@id/iv_arrow_right"
            app:layout_constraintTop_toBottomOf="@id/iv_arrow_up"
            app:layout_constraintBottom_toTopOf="@id/iv_arrow_down"/>

        <View
            android:id="@+id/view_frame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:duplicateParentState="true"
            app:layout_constraintTop_toTopOf="@id/my_video"
            app:layout_constraintBottom_toBottomOf="@id/my_video"
            app:layout_constraintStart_toStartOf="@id/my_video"
            app:layout_constraintEnd_toEndOf="@id/my_video"
            android:background="@drawable/view_focused_background"/>

        <ImageView
            android:id="@+id/iv_arrow_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/colorAccent"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/my_video"
            app:layout_constraintBottom_toBottomOf="@id/my_video"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/iv_arrow_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/colorAccent"
            android:rotation="90"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/my_video"
            app:layout_constraintEnd_toEndOf="@id/my_video"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_arrow_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/colorAccent"
            android:rotation="180"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/my_video"
            app:layout_constraintBottom_toBottomOf="@id/my_video"
            app:layout_constraintEnd_toEndOf="parent"/>
        <ImageView
            android:id="@+id/iv_arrow_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/colorAccent"
            android:rotation="-90"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/my_video"
            app:layout_constraintEnd_toEndOf="@id/my_video"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/view_mask"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:duplicateParentState="true"
            app:layout_constraintTop_toTopOf="@id/my_video"
            app:layout_constraintBottom_toBottomOf="@id/my_video"
            app:layout_constraintStart_toStartOf="@id/my_video"
            app:layout_constraintEnd_toEndOf="@id/my_video"
            android:scaleType="centerCrop"
            android:src="@color/black"
            android:alpha="0.7"
            android:padding="0dp"
            android:visibility="gone"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <view
        class="com.ntt.skyway.core.content.sink.SurfaceViewRenderer"
        android:id="@+id/full_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <view
        class="com.ntt.skyway.core.content.sink.SurfaceViewRenderer"
        android:id="@+id/screen_sharing_owner_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintTop_toTopOf="@id/full_view"
        app:layout_constraintEnd_toEndOf="@id/full_view"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/full_view_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:duplicateParentState="true"
        app:layout_constraintTop_toTopOf="@id/full_view"
        app:layout_constraintBottom_toBottomOf="@id/full_view"
        app:layout_constraintStart_toStartOf="@id/full_view"
        app:layout_constraintEnd_toEndOf="@id/full_view"
        android:scaleType="centerCrop"
        android:src="@color/black"
        android:alpha="0.7"
        android:padding="0dp"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/screen_sharing_owner_view_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/screen_sharing_owner_view"
        app:layout_constraintBottom_toBottomOf="@id/screen_sharing_owner_view"
        app:layout_constraintStart_toStartOf="@id/screen_sharing_owner_view"
        app:layout_constraintEnd_toEndOf="@id/screen_sharing_owner_view"
        android:scaleType="centerCrop"
        android:src="@color/black"
        android:alpha="0.7"
        android:padding="0dp"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_arrow_back"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_margin="@dimen/padding_small"
        android:background="@drawable/circle_button_background"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/colorAccent"
        app:layout_constraintTop_toTopOf="parent"/>


    <TextView
        android:id="@+id/lbl_room_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#4D000000"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>



    <include android:id="@+id/layout_menu" layout="@layout/layout_room_actions"/>

    <include
        android:id="@+id/layout_chat"
        android:layout_width="@dimen/chat_layout_width"
        android:layout_height="match_parent"
        layout="@layout/layout_chat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:elevation="2dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>