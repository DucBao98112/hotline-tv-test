<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/layout_video"
    app:layout_constraintBottom_toBottomOf="parent"
    android:focusable="true"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHeight_percent="0.3"
    app:layout_constraintDimensionRatio="4:3"
    android:layout_width="0dp"
    android:layout_height="0dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <view class="com.ntt.skyway.core.content.sink.SurfaceViewRenderer"
        android:id="@+id/view_local_video"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:duplicateParentState="true"
        app:layout_constraintStart_toEndOf="@id/iv_arrow_left"
        app:layout_constraintEnd_toStartOf="@id/iv_arrow_right"
        app:layout_constraintTop_toBottomOf="@id/iv_arrow_up"
        app:layout_constraintBottom_toTopOf="@id/iv_arrow_down"
        android:background="@drawable/view_focused_background"/>

    <ImageView
        android:id="@+id/iv_arrow_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_right"
        android:layout_marginEnd="@dimen/padding_small"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/view_local_video"
        app:layout_constraintBottom_toBottomOf="@id/view_local_video"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/iv_arrow_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_right"
        android:layout_marginBottom="@dimen/padding_small"
        android:rotation="90"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/view_local_video"
        app:layout_constraintEnd_toEndOf="@id/view_local_video"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_arrow_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_right"
        android:rotation="180"
        android:visibility="gone"
        android:layout_marginStart="@dimen/padding_small"
        app:layout_constraintTop_toTopOf="@id/view_local_video"
        app:layout_constraintBottom_toBottomOf="@id/view_local_video"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/iv_arrow_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_right"
        android:rotation="-90"
        android:visibility="gone"
        android:layout_marginTop="@dimen/padding_small"
        app:layout_constraintStart_toStartOf="@id/view_local_video"
        app:layout_constraintEnd_toEndOf="@id/view_local_video"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>