<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:bottom="6dp" android:left="6dp" android:right="6dp" android:top="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/secondary_button_background_color" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <item android:right="7dp">
                <bitmap android:gravity="right" android:src="@drawable/ic_arrow_down" android:tint="@color/colorPrimary" />
            </item>
            <item android:drawable="@drawable/bg_card_neon_border" />
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:top="6dp"
                android:left="6dp"
                android:right="6dp"
                android:bottom="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/secondary_button_background_color"/>
                    <stroke android:width="1dp" android:color="@color/gray"/>
                    <corners android:radius="5dp"/>
                </shape>
            </item>
            <item android:right="7dp">
                <bitmap
                    android:gravity="right"
                    android:src="@drawable/ic_arrow_down"
                    android:tint="?attr/text_color_light"/>
            </item>
        </layer-list>
    </item>
</selector>