<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item
                android:top="8dp"
                android:left="8dp"
                android:right="8dp"
                android:bottom="8dp">
                <shape>
                    <corners android:radius="5dp" />
                    <solid android:color="?attr/textbox_background_color" />
                    <stroke android:width="1dp" android:color="@color/textbox_border_color"/>
                </shape>
            </item>

            <item android:drawable="@drawable/bg_card_neon_border"/>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:top="8dp"
                android:left="8dp"
                android:right="8dp"
                android:bottom="8dp">
                <shape>
                    <corners android:radius="5dp" />
                    <stroke android:width="1dp" android:color="@color/textbox_border_color"/>
                    <solid android:color="?attr/textbox_background_color" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>