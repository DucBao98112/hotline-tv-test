<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item
                android:top="5dp"
                android:left="5dp"
                android:right="5dp"
                android:bottom="5dp">
                <shape>
                    <corners android:radius="3dp" />
                    <solid android:color="?attr/textbox_background_color" />
                    <stroke android:width="1dp" android:color="@color/textbox_border_color"/>
                </shape>
            </item>

            <item android:drawable="@drawable/bg_menu_neon_border"/>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:top="5dp"
                android:left="5dp"
                android:right="5dp"
                android:bottom="5dp">
                <shape>
                    <corners android:radius="3dp" />
                    <stroke android:width="1dp" android:color="@color/textbox_border_color"/>
                    <solid android:color="?attr/box_background_color" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>