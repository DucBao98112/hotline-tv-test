<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_focused="true">
        <layer-list>
            <item
                android:top="6dp"
                android:left="6dp"
                android:right="6dp"
                android:bottom="6dp">
                <shape>
                    <corners android:radius="5dp" />
                    <solid android:color="@color/colorPrimary" />
                </shape>
            </item>
            <item android:drawable="@drawable/bg_card_neon_border"/>
        </layer-list>
    </item>

    <item android:state_activated="true" android:state_focused="false">
        <layer-list>
            <item
                android:top="6dp"
                android:left="6dp"
                android:right="6dp"
                android:bottom="6dp">
                <shape>
                    <corners android:radius="5dp" />
                    <solid android:color="@color/colorPrimary" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_focused="true" android:state_activated="false">
        <layer-list>
            <item
                android:top="6dp"
                android:left="6dp"
                android:right="6dp"
                android:bottom="6dp">
                <shape>
                    <corners android:radius="5dp" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:drawable="@drawable/bg_card_neon_border"/>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item
                android:top="6dp"
                android:left="6dp"
                android:right="6dp"
                android:bottom="6dp">
                <shape>
                    <corners android:radius="5dp" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>